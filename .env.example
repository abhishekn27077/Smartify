# ==============================================================================
# SMARTIFY — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS FOR DEVELOPERS:
# 1. To run the app against the default demo environment, NO .env file is required.
#    The Flutter client uses verified fallback demo credentials automatically.
# 2. To point to your own Supabase instance:
#    Copy this file to .env:
#      powershell: Copy-Item .env.example .env
#      bash:       cp .env.example .env
# 3. Fill in your project URL and publishable anon key below.
# 4. NEVER commit the actual .env file to Git.
# ==============================================================================

# --- Client Application Configuration (Safe for Flutter Mobile App) ---
# Your Supabase Project URL (Supabase Dashboard > Project Settings > API > Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable / Anon Key (Supabase Dashboard > Project Settings > API > anon/public)
# Row Level Security (RLS) protects all database operations authenticated with this key.
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# ==============================================================================
# --- Administrative / Migration Tools ONLY (NEVER Expose to Mobile App) ---
# ==============================================================================
# NOTE FOR GUEST / FRIEND DEVELOPERS:
# You DO NOT need these values to build, run, or test the mobile app!
# These values are exclusively used by the project owner for running backend
# SQL migrations in supabase/migrations/ or executing backend administrative jobs.
#
# Direct PostgreSQL connection string:
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_db_password_here@db.your-project-id.supabase.co:5432/postgres

# Supabase Service Role Key (Supabase Dashboard > Project Settings > API > service_role)
# Bypasses RLS. NEVER provide this to clients, friends, or APK builds.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
